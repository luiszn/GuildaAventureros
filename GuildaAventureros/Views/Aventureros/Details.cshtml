@model Aventurero
@{
    ViewData["Title"] = "Detalle del aventurero";
}
<h2>@Model.Nombre</h2>
<dl class="row">
    <dt class="col-sm-3">Especialidad</dt><dd class="col-sm-9">@Model.Especialidad?.Nombre</dd>
    <dt class="col-sm-3">Nivel</dt><dd class="col-sm-9">@Model.Nivel</dd>
    <dt class="col-sm-3">Estado</dt><dd class="col-sm-9">@(Model.Estado ? "Activo" : "Inactivo")</dd>
    <dt class="col-sm-3">Fecha de registro</dt><dd class="col-sm-9">@Model.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</dd>
</dl>
<a asp-action="Edit" asp-route-id="@Model.IdAventurero" class="btn btn-primary">Editar</a>
<a asp-action="Index" class="btn btn-link">Volver</a>
