@model IEnumerable<Aventurero>
@{
    ViewData["Title"] = "Aventureros";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Aventureros</h2>
    <a class="btn btn-primary" asp-action="Create">+ Registrar aventurero</a>
</div>
<table class="table table-hover align-middle">
    <thead>
        <tr>
            <th>#</th>
            <th>Nombre</th>
            <th>Especialidad</th>
            <th>Nivel</th>
            <th>Estado</th>
            <th>Registro</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var a in Model)
    {
        <tr>
            <td>@a.IdAventurero</td>
            <td>@a.Nombre</td>
            <td>@a.Especialidad?.Nombre</td>
            <td>@a.Nivel</td>
            <td>
                @if (a.Estado) { <span class="badge bg-success">Activo</span> }
                else { <span class="badge bg-secondary">Inactivo</span> }
            </td>
            <td>@a.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</td>
            <td class="text-end">
                <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@a.IdAventurero">Ver</a>
                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@a.IdAventurero">Editar</a>
                <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@a.IdAventurero">Eliminar</a>
            </td>
        </tr>
    }
    @if (!Model.Any())
    {
        <tr><td colspan="7" class="text-center text-muted">No hay aventureros registrados.</td></tr>
    }
    </tbody>
</table>
