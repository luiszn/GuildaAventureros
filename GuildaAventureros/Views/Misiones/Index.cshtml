@model IEnumerable<Mision>
@{
    ViewData["Title"] = "Misiones";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Misiones</h2>
    <a class="btn btn-primary" asp-action="Create">+ Registrar misión</a>
</div>
<table class="table table-hover align-middle">
    <thead>
        <tr>
            <th>#</th>
            <th>Título</th>
            <th>Dificultad</th>
            <th class="text-end">Recompensa</th>
            <th>Estado</th>
            <th>Publicación</th>
            <th class="text-center">Asignaciones</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var m in Model)
        {
            var cssDificultad = m.Dificultad switch { "Fácil" => "bg-success", "Media" => "bg-warning text-dark", "Difícil" => "bg-danger", _ => "bg-secondary" };
            var cssEstado = m.Estado switch { "Disponible" => "bg-success", "En curso" => "bg-info text-dark", "Completada" => "bg-secondary", _ => "bg-light text-dark" };
            <tr>
                <td>@m.IdMision</td>
                <td>@m.Titulo</td>
                <td><span class="badge @cssDificultad">@m.Dificultad</span></td>
                <td class="text-end">@m.Recompensa.ToString("N2")</td>
                <td><span class="badge @cssEstado">@m.Estado</span></td>
                <td>@m.FechaPublicacion.ToString("dd/MM/yyyy HH:mm")</td>
                <td class="text-center">@m.Asignaciones.Count</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@m.IdMision">Ver</a>
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@m.IdMision">Editar</a>
                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@m.IdMision">Eliminar</a>
                </td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr><td colspan="8" class="text-center text-muted">No hay misiones registradas.</td></tr>
        }
    </tbody>
</table>
