@model Mision

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<div class="mb-3">
    <label asp-for="Titulo" class="form-label"></label>
    <input asp-for="Titulo" class="form-control" maxlength="120" />
    <span asp-validation-for="Titulo" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Descripcion" class="form-label"></label>
    <textarea asp-for="Descripcion" class="form-control" rows="4" maxlength="500"></textarea>
    <span asp-validation-for="Descripcion" class="text-danger"></span>
</div>

<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="Dificultad" class="form-label"></label>
        <select asp-for="Dificultad" asp-items="(SelectList)ViewBag.Dificultades" class="form-select">
            <option value="">-- Seleccione la dificultad --</option>
        </select>
        <span asp-validation-for="Dificultad" class="text-danger"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="Recompensa" class="form-label"></label>
        <input asp-for="Recompensa" type="number" step="0.01" min="0.01" class="form-control" />
        <span asp-validation-for="Recompensa" class="text-danger"></span>
    </div>
</div>

<div class="mb-3">
    <label asp-for="Estado" class="form-label"></label>
    <select asp-for="Estado" asp-items="(SelectList)ViewBag.Estados" class="form-select">
        <option value="">-- Seleccione el estado --</option>
    </select>
    <span asp-validation-for="Estado" class="text-danger"></span>
</div>
